{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@propie/registration-validation": ["../src/shared/registration/index.ts"],
      "@propie/registration-validation/*": ["../src/shared/registration/*"]
    }
  },
  "include": ["src", "../src/shared/registration/**/*.ts"]
}
